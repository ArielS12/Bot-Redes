@page "/login"
@layout EmptyLayout

<PageTitle>Iniciar sesión</PageTitle>

<div class="tb-login-card shadow-lg">
    <div class="tb-login-brand mb-4">
        <span class="tb-login-logo" aria-hidden="true"></span>
        <div>
            <h1 class="h4 mb-0">Trading Bots</h1>
            <p class="text-muted small mb-0">Modo público</p>
        </div>
    </div>
    <div class="alert alert-info py-2" role="status">
        El inicio de sesión está deshabilitado: la API y el panel funcionan sin JWT
        (constante <code>PublicAppMode.Enabled</code> en el proyecto). Vuelve al <a href="/">dashboard</a>.
    </div>
</div>

@* Formulario de login original (reactivar con JWT en Program.cs y ClientAuthSession).
@inject IHttpClientFactory HttpFactory
@inject ClientAuthSession Auth
...
*@
